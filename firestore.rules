rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-trust policy: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict user isolation under users/{uid}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subCollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
