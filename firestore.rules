rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-trust policy: Deny unauthenticated access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User data isolation: allows root document and all subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null;

      match /{subCollection=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Optional legacy tenant mirror
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
