# ProGuard / R8 Rules for SamMikrotik Production Release

# 1. Line numbers and debugging attributes in crash reports
-keepattributes SourceFile,LineNumberTable
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod

# 2. Room Database and SQLite
-keep class * extends androidx.room.RoomDatabase
-keep @androidx.room.Dao interface * { *; }
-keep @androidx.room.Entity class * { *; }
-keep class * extends androidx.room.TypeConverter { *; }
-keep class com.example.data.local.** { *; }
-dontwarn androidx.room.paging.**

# 3. Domain Models and Business Entities (IFRS Ledger, Values, Ratios)
-keep class com.example.domain.model.** { *; }
-keep class com.example.core.** { *; }
-keep class com.example.data.local.entities.** { *; }

# 4. JSON Serialization (Moshi, Retrofit, Converter)
-keepclasseswithmembers class * {
    @com.squareup.moshi.* <methods>;
}
-keepclasseswithmembers class * {
    @com.squareup.moshi.* <fields>;
}
-keep class com.squareup.moshi.** { *; }
-keep interface retrofit2.** { *; }
-keep class retrofit2.** { *; }
-dontwarn retrofit2.**
-dontwarn okhttp3.**
-dontwarn okio.**

# 5. Firebase and Google Play Services
-keep class com.google.firebase.** { *; }
-keep class com.google.android.gms.** { *; }
-dontwarn com.google.firebase.**
-dontwarn com.google.android.gms.**

# 6. AndroidX Credential Manager & Google ID
-keep class androidx.credentials.** { *; }
-keep class com.google.android.libraries.identity.googleid.** { *; }

# 7. Kotlin Coroutines and Flow
-keepnames class kotlinx.coroutines.internal.MainDispatcherFactory {}
-keepnames class kotlinx.coroutines.CoroutineExceptionHandler {}
-keepclassmembernames class kotlinx.** {
    volatile <fields>;
}

# 8. Jetpack Compose
-keep class androidx.compose.** { *; }
-dontwarn androidx.compose.**

# 9. App Database implementation generated by Room/KSP
-keep class com.example.data.local.AppDatabase_Impl {
    public void createAllTables(androidx.sqlite.db.SupportSQLiteDatabase);
    public androidx.room.RoomOpenDelegate createOpenDelegate();
}
